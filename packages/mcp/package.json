{
  "name": "@aihubmix/mcp",
  "version": "2.0.0",
  "description": "Official AIHubMix MCP server (OpenRouter-parity): live model catalog, pricing, credits, account/keys, docs search, test-chat, and image/video generation for AI coding tools (Claude Code / Codex / Cursor). stdio + Streamable HTTP.",
  "license": "MIT",
  "author": "chenxue",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "aihubmix-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "type-check": "tsc --noEmit",
    "prepack": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http --port 7300",
    "test": "node test/smoke.mjs",
    "test:http": "node test/smoke-http.mjs",
    "test:failover": "node test/failover.mjs",
    "test:redact": "node test/redact.mjs",
    "test:keyrecord": "node test/keyrecord.mjs",
    "test:keyadmin": "node test/keyadmin.mjs"
  },
  "dependencies": {
    "@aihubmix/media-adapters": "^0.2.2",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "aihubmix",
    "ai",
    "llm",
    "server",
    "tools"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inferera/aihubmix.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
